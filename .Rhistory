filter(Counts > 1)
ggplot(words_more,
aes(label = EachWord,
size  = Counts,
color = Counts)) +
geom_text_wordcloud_area(eccentricity = 0.7,
rm_outside = TRUE) +
scale_size_area(max_size = 18) +
scale_color_gradient(low = "red", high = "darkred") +
theme_minimal(base_size = 16) +
labs(title = "Word cloud of frequent terms")
bigrams <- text_df |>
unnest_tokens(bigram, text, token = "ngrams", n = 2)
#view
head(bigrams)
bigrams_inColumns <- bigrams |>
separate_wider_delim(bigram,
names = c("word1", "word2"),
delim = " ") |>
filter(!is.na(word1),
!is.na(word2))
bigrams_inColumns
bigram_counts<- bigrams_inColumns|>
filter(!word1 %in% stop_words$word,
!word2 %in% stop_words$word) |>
filter(!word1 %in% badWords,
!word2 %in% badWords) |>
count(word1, word2, sort = TRUE) |>
filter(n >= 1)
#view
(bigram_counts)
bigram_graph <- graph_from_data_frame(bigram_counts,directed = F)
bigram_graph
V(bigram_graph)$name
E(bigram_graph)$n
ggraph::ggraph(bigram_graph ,layout="fr") +
geom_edge_link() +
geom_node_point()
ggraph::ggraph(bigram_graph,layout="fr") +
geom_edge_link() +
geom_node_point() +
geom_node_text(aes(label = name))
ggraph::ggraph(bigram_graph, layout = "fr") +
geom_edge_link(aes(width = n)) +
geom_node_point() +
geom_node_text(aes(label = name))
ggraph::ggraph(bigram_graph, layout = "fr") + theme_void() +
geom_edge_link(aes(width = n), alpha = 0.4, color='blue') +
geom_node_point(size = 4) +
geom_node_text(aes(label = name), repel = TRUE, size = 5)
#loading library
library(tidyverse)
library(ggplot2)
library(plotly)
library(magrittr)
library(rio)
library(sf)
library(readxl)
library(tidytext)
library(ggwordcloud)
library(igraph)
library(ggraph)
linkboston <- "https://github.com/DACSS-Visual/HW_maps_text_instructions/raw/main/BostonContrib.xlsx"
boston <- rio::import(linkboston)
#view
head(boston)
linkzips <- 'https://github.com/DACSS-Visual/HW_maps_text_instructions/raw/main/zip_codes.json'
bostonzips <- sf::read_sf(linkzips)
#view
head(bostonzips)
colnames(boston)
colnames(bostonzips)
summary(boston$Amount)
table(boston$`Tender Type Description`)
ggplot(data = bostonzips ) + geom_sf()
head(boston)
boston_tender <- boston |>
filter(`Tender Type Description` %in% c("Check", "Transfer"))
head(boston_tender)
zip_total <- boston_tender |>
group_by(Zip, `Tender Type Description`) |>
summarize(
total_contrib = sum(Amount, na.rm = TRUE),
.groups = "drop"
)
zip_wide <- zip_total |>
pivot_wider(
names_from = `Tender Type Description`,
values_from = total_contrib,
values_fill = 0
)
names(zip_wide)
names(bostonzips)
zip_map <- bostonzips |>
left_join(zip_wide,
by = c(ZIP5 = "Zip"))
base <- ggplot(data = zip_map)
base + geom_sf(aes(fill = Check),
color = "white",
linewidth = 0.1) +
scale_fill_viridis_c(direction = -1,
option = "viridis",
na.value = "grey"
) +
labs(
title= "Check Contributions by Zip Code",
fill = "Total Contributions"
) +
theme_minimal()
base + geom_sf(aes(fill = Transfer),
color = "white",
linewidth = 0.1) +
scale_fill_viridis_c(direction = -1,
option = "viridis",
na.value = "grey"
) +
labs(
title = "Transfer Contributions by ZIP Code",
fill = "Total Contributions"
) +
theme_minimal()
summary(zip_map$Check)
summary(zip_map$Transfer)
link <- readLines("https://raw.githubusercontent.com/dparke92/hw5/main/fascism.txt")
text_df <- tibble(text = link)
text_df |>
unnest_tokens(
output = EachWord,
input  = text,
token  = "words"
) |>head()
words_df <- text_df|>
unnest_tokens(
output = EachWord,
input  = text,
token  = "words"
)
head(words_df)
nrow(words_df)
data(stop_words)
head(stop_words)
words_df <- words_df |>
anti_join(stop_words, by = c("EachWord" = "word"))
nrow(words_df)
sort(table(words_df$EachWord)) |>
tail(10)
badWords <- c("based", "party")
words_clean <- words_df |>
filter(!EachWord %in% badWords)
words_count <- words_clean |>
count(EachWord, name = "Counts", sort = TRUE)
words_count
words_more <- words_clean |>
count(EachWord, name = "Counts", sort = TRUE) |>
filter(Counts > 1)
ggplot(words_more,
aes(label = EachWord,
size  = Counts,
color = Counts)) +
geom_text_wordcloud_area(eccentricity = 0.7,
rm_outside = TRUE) +
scale_size_area(max_size = 18) +
scale_color_gradient(low = "red", high = "darkred") +
theme_minimal(base_size = 16) +
labs(title = "Word cloud of frequent terms")
bigrams <- text_df |>
unnest_tokens(bigram, text, token = "ngrams", n = 2)
#view
head(bigrams)
bigrams_inColumns <- bigrams |>
separate_wider_delim(bigram,
names = c("word1", "word2"),
delim = " ") |>
filter(!is.na(word1),
!is.na(word2))
bigrams_inColumns
bigram_counts<- bigrams_inColumns|>
filter(!word1 %in% stop_words$word,
!word2 %in% stop_words$word) |>
filter(!word1 %in% badWords,
!word2 %in% badWords) |>
count(word1, word2, sort = TRUE) |>
filter(n >= 1)
#view
(bigram_counts)
bigram_graph <- graph_from_data_frame(bigram_counts,directed = F)
bigram_graph
V(bigram_graph)$name
E(bigram_graph)$n
ggraph::ggraph(bigram_graph ,layout="fr") +
geom_edge_link() +
geom_node_point()
ggraph::ggraph(bigram_graph,layout="fr") +
geom_edge_link() +
geom_node_point() +
geom_node_text(aes(label = name))
ggraph::ggraph(bigram_graph, layout = "fr") +
geom_edge_link(aes(width = n)) +
geom_node_point() +
geom_node_text(aes(label = name))
ggraph::ggraph(bigram_graph, layout = "fr") + theme_void() +
geom_edge_link(aes(width = n), alpha = 0.4, color='blue') +
geom_node_point(size = 4) +
geom_node_text(aes(label = name), repel = TRUE, size = 5)
